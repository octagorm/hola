# Files with a hash in their names never change
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Nor do the recordings: each is named by a hash of the file itself
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# And the audiobooks, named by a hash of theirs
/lydbok/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/admin
  X-Robots-Tag: noindex, nofollow
