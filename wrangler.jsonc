{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hola",
  "compatibility_date": "2026-10-10",
  // Only static files: nothing runs on the server. Headers are in
  // public/_headers.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
}
